# ==============================================================================
# Agentic AI Research & Outreach Assistant - Environment Configuration
# ==============================================================================

# Groq API Key (Obtain a free key at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Name
# Supported fast & high-performance models:
# - groq/llama-3.3-70b-versatile
# - groq/llama-3.1-70b-versatile
# - groq/llama-3.1-8b-instant
GROQ_MODEL=groq/llama-3.3-70b-versatile

# Autonomous Agent Configuration
MAX_RESEARCH_ITERATIONS=3
EVIDENCE_CONFIDENCE_THRESHOLD=0.75

# Human-In-The-Loop Gmail Configuration
# Path to your downloaded OAuth 2.0 client credentials from Google Cloud Console
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# If set to true, allows running an offline test/simulation without requiring an active Groq API key
MOCK_LLM_MODE=false
